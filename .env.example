# Copy to .env and fill in what you need. Every value is optional.

# Enables POST /chat (the Claude tool-use loop).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Enables Langfuse tracing of every tool call and agent run.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
